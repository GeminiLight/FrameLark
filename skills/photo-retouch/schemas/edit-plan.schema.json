              "settings": {
                "type": "object",
                "properties": {
                  "exposure": {
                    "type": "number",
                    "minimum": -1.5,
                    "maximum": 1.5
                  },
                  "contrast": {
                    "type": "number",
                    "minimum": -75,
                    "maximum": 75
                  },
                  "highlights": {
                    "type": "number",
                    "minimum": -75,
                    "maximum": 75
                  },
