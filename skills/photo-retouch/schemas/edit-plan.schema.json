                    "y": {
                      "type": "number",
                      "minimum": 0.02,
                      "maximum": 0.94
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0.08,
                      "maximum": 0.96
                    },
                    "size": {
                      "type": "number",
