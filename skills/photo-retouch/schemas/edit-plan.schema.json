                    "id": {
                      "type": "string",
                      "pattern": "^[-\\w]{1,64}$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "style": {
                      "enum": [
                        "airy",
                        "sticker",
                        "editorial"
                      ]
                    },
                    "font": {
                      "enum": [
                        "sans",
                        "rounded",
                        "serif"
