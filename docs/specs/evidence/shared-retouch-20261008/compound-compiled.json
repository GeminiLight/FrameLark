  "items": [
    {
      "id": "trial-shadow-lift",
      "title": "暗部稍亮，保护已有亮处",
      "visual": {
        "goal": "小幅提高暗部可读性。",
        "benefit": "让两侧塔架和底部云层的轮廓更容易辨认。",
        "tradeoff": "深蓝天空也会稍亮，暗部噪点可能更明显；预览时检查实际蒙版、灯头、光晕和过渡。",
        "findingIds": []
      },
      "commands": [
        {
          "type": "AddStep",
          "step": {
            "id": "exposure-shadow-trial",
            "title": "暗部曝光 +0.3 EV",
            "tool": "exposure",
            "toolVersion": 2,
            "kernelVersion": 1,
            "parameters": {
              "ev": 0.3,
              "headroomPolicy": "limit-positive-gain"
            },
            "enabled": true,
            "opacity": 1,
            "maskRef": null,
            "groupId": null
          }
        },
        {
          "type": "ReplaceStepMask",
          "stepId": "exposure-shadow-trial",
          "mask": {
            "expression": {
              "kind": "luminance",
              "mode": "exclude-highlights",
              "start": 0.1,
              "end": 0.35
            },
            "reference": {
              "kind": "live-input"
            }
          }
        }
      ],
      "dependsOn": []
    },
    {
      "id": "trial-warmth-plus-two",
      "title": "色温 warmth 增加 2",
      "visual": {
        "goal": "将 warmth 从当前默认值 0 增至 2。",
        "benefit": "提供轻微加暖的版本，便于与原色比较。",
        "tradeoff": "加暖作用于全图；检查蓝色天空是否仍符合想保留的夜色。",
        "findingIds": []
      },
      "commands": [
        {
          "type": "AddStep",
          "step": {
