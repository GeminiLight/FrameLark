    {
      "id": "trial-clockwise-rotation",
      "title": "单独顺时针旋转 0.5°",
      "visual": {
        "goal": "试看片顺时针旋转 0.5° 的效果。",
        "benefit": "便于核对火箭中轴和两侧塔架的倾斜感。",
        "tradeoff": "四角可能出现空边或轻微裁切，需在预览中核对。",
