# Optional: manual editing works without a model connection.
# Copy this file to .env.local and fill in your provider's own values,
# or configure the visual model from the local application's settings.
# These names also support OpenAI-compatible visual providers.
OPENAI_API_KEY=
OPENAI_MODEL=
# Full /v1/responses or /v1/chat/completions endpoint; a /v1 base is accepted.
OPENAI_API_URL=
